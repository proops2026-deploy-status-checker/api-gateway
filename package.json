{
  "name": "api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Deploy Status Checker - API Gateway",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy:static",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint .",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:coverage": "tsc -p tsconfig.json --sourceMap && npm run copy:static && c8 --reporter=lcov --reporter=text --include=dist/** --include=src/public/** --exclude=dist/public/** node --test test/*.test.cjs",
    "copy:static": "node -e \"require('node:fs').cpSync('src/public','dist/public',{recursive:true})\"",
    "issue-token": "node scripts/issue-token.cjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0"
  }
}
